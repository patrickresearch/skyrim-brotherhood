EndFunction

Function ArmDeathWatch()
    Int iStage = GetStage()
    If bDeathWatch || iStage < 10 || iStage >= 70
        Return
    EndIf
    bDeathWatch = True
    RequestUpdate(5.0)
EndFunction

; Stage 10-69: a dead Hakan or Hrefna must not leave the quest without a way forward.
Function DeathWatchTick()
    Int iStage = GetStage()
    If iStage < 10 || iStage >= 70
        bDeathWatch = False
        Return
    EndIf
    If !bHakanDeathHandled && iStage < 20
        Actor kHakan = GetHakan()
        If kHakan && kHakan.IsDead()
            HandleHakanDeath(kHakan)
        EndIf
    EndIf
    If !bHrefnaDeathHandled && iStage >= 46
        Actor kHrefna = GetHrefna()
        If kHrefna && kHrefna.IsDead()
            HandleHrefnaDeath(kHrefna)
        EndIf
    EndIf
EndFunction

; Hakan died before he named his suspect (stage 10-19): his notes carry the clue, the farm appears on the map and the
; quest moves on exactly as after the marker handover (same calls as the end of the hret topic, TIF__02007146).
Function HandleHakanDeath(Actor akHakan)
    bHakanDeathHandled = True
    EnsureNote(akHakan, 0x00AD40)
    If GetStage() >= 20 || NHV_Util.FlowGet(0x00711D) == 1
        Return
    EndIf
    NHV_Util.Log(NHV_Cfg_Debug, "Hakan died before his talk was over: farm marker and stage 20 by script, notes on the body")
    NHV_Util.FlowSet(0x00711D, 1)
    ReleaseReedbedSack()
    OnMarkerReturned()
    NHV_Util.FlowObjective(0x004000, 9003, 9004)
    NHV_Util.FlowStage(0x004000, 20)
    NHV_Util.FlowSet(0x007000, 0)
    NHV_Util.FlowSet(0x007001, 43)
EndFunction

; Hrefna died before the judgement (stage 20-69): the outcome is "killed", the debrief at stage 100 takes over, and her
; confession lies on the body. The fragment is handed over so the debrief condition (fragment in the inventory) holds.
Function HandleHrefnaDeath(Actor akHrefna)
    bHrefnaDeathHandled = True
    EnsureNote(akHrefna, 0x00AD41)
    If GetStage() >= 70
        Return
    EndIf
    If NHV_Status_Hrefna
        Int iCurrent = NHV_Status_Hrefna.GetValueInt()
        If iCurrent == STATUS_RECRUITED || iCurrent == STATUS_RELEASED || iCurrent == STATUS_SPECIAL
            Return
        EndIf
        NHV_Status_Hrefna.SetValueInt(STATUS_KILLED)
    EndIf
    If GetStage() < 46
        Return
    EndIf
    NHV_Util.Log(NHV_Cfg_Debug, "Hrefna died before the judgement: outcome killed, quest moves to stage 100")
    ; clean up what stage 46-69 may have left running before the jump
    UnlockCutscene()
    ReleaseVeyraFromTrial()
    If VeyraTrialScene && VeyraTrialScene.IsPlaying()
        VeyraTrialScene.Stop()
    EndIf
    If QuintusApproachScene && QuintusApproachScene.IsPlaying()
        QuintusApproachScene.Stop()
    EndIf
    SetQuintusAtFarm(False)
    bHrefnaWillKill = False
    Int iObj = 9001
    While iObj <= 9019
        If IsObjectiveDisplayed(iObj) && !IsObjectiveCompleted(iObj)
            SetObjectiveCompleted(iObj)
        EndIf
        iObj += 1
    EndWhile
    GiveOculatusFragment()
    SetStage(100)
EndFunction

; Q01 hooks the Stage 10 start fragment (it calls FillVeyraAlias()) to arm the death watch without touching the fragment.
Function FillVeyraAlias()
    Parent.FillVeyraAlias()
    ArmDeathWatch()
EndFunction

; Hakan takes the red ferry marker: the item leaves the inventory, the farm appears on the map.
Function OnMarkerReturned()
    Form kItem = Game.GetFormFromFile(0x007F24, "NightsHarvest.esp")
    Actor kPlayer = Game.GetPlayer()
    If kItem && kPlayer.GetItemCount(kItem) > 0
        kPlayer.RemoveItem(kItem, kPlayer.GetItemCount(kItem), True)
    EndIf
    EnableMarker(1)
    BeginVeyraWatch()
EndFunction

; Stage 20-69: Veyra lives in the Deep Sanctuary, so nothing but a script brings her to the player. She steps in behind the player
; when the farm comes close (or the player stands in its cell) and catches up again whenever she is left behind (fast travel, doors).
Function BeginVeyraWatch()
    If bVeyraWatch
        Return
    EndIf
    bVeyraWatch = True
    FillVeyraAlias()
    RegisterForSingleUpdate(3.0)
    NHV_Util.Log(NHV_Cfg_Debug, "Veyra watch started")
EndFunction

Function VeyraTick()
    Int iStage = GetStage()
    If iStage < 20 || iStage >= 70
        bVeyraWatch = False
        If iStage < 20
            bVeyraJoined = False ; quest reset: she joins at the farm again
            SetQuintusAtFarm(False)
        EndIf
        Return
    EndIf
    If IsCutsceneLocked()
        Return
    EndIf
    Actor kPlayer = Game.GetPlayer()
    If !VeyraAlias || !VeyraAlias.GetActorRef()
        FillVeyraAlias()
    EndIf
    Actor kVeyra = None
    If VeyraAlias
        kVeyra = VeyraAlias.GetActorRef()
    EndIf
    If !kVeyra || kVeyra.IsDead() || kVeyra.IsDisabled()
        Return
    EndIf
    Bool bNear = kVeyra.Is3DLoaded() && kPlayer.GetDistance(kVeyra) < 2500.0
    If !bVeyraJoined
        Cell kFarm = Game.GetFormFromFile(0x0048A8, "NightsHarvest.esp") as Cell
        Bool bAtFarm = kFarm && kPlayer.GetParentCell() == kFarm
        If !bAtFarm && FarmMapMarker && kPlayer.GetParentCell() == FarmMapMarker.GetParentCell()
            bAtFarm = kPlayer.GetDistance(FarmMapMarker) < 3500.0
        EndIf
        If !bAtFarm
            Return
        EndIf
    ElseIf bNear || kPlayer.IsInCombat()
        Return ; close enough, or never pull her around mid-fight
    EndIf
    Float fAngle = kPlayer.GetAngleZ()
    kVeyra.MoveTo(kPlayer, -300.0 * Math.Sin(fAngle), -300.0 * Math.Cos(fAngle), 0.0)
    kVeyra.EvaluatePackage()
    bVeyraJoined = True
    NHV_Util.Log(NHV_Cfg_Debug, "Veyra steps in beside the player")
EndFunction

; End of the scout conversation: the camp appears on the map and the quest moves on to stage 30, where the camp poll waits for the player.
Function GoToCamp()
    EnableMarker(3)
    If GetStage() < 30
        SetStage(30)
    EndIf
EndFunction

; The player hands Hrefna the letter to the daughter: it leaves the inventory just before she reacts to it (she has read it).
Function TakeLetter()
    Form kLetter = Game.GetFormFromFile(0x007F10, "NightsHarvest.esp")
    Actor kPlayer = Game.GetPlayer()
    If kLetter && kPlayer.GetItemCount(kLetter) > 0
        kPlayer.RemoveItem(kLetter, kPlayer.GetItemCount(kLetter), True)
        NHV_Util.Log(NHV_Cfg_Debug, "TakeLetter: the letter went to Hrefna")
    EndIf
EndFunction

; Q01 -> Q02 transition (end of the debrief): Veyra goes to the map table in the Ledger Room and greets the player there once;
; the table itself (NHV_MapTableScript, Q01 stage 100 unlocks it) starts the next contract. Idempotent.
Bool bTableOpened = False
Bool bTableCursorPending = False ; the debrief chain resets the cursor right after OpenMapTable(): the greeting is armed a moment later
Bool bDebriefWatch = False ; stage 100 until the debrief ended: Veyra comes to the player inside the sanctuary cells (no console search)

Function BeginDebriefWatch()
    If bDebriefWatch || bTableOpened
        Return
    EndIf
    bDebriefWatch = True
    RegisterForSingleUpdate(4.0)
    NHV_Util.Log(NHV_Cfg_Debug, "Debrief watch started")
EndFunction

; The debrief is Veyra's Hello. Wherever the script left her (the return marker is an exterior spot in Dawnstar), she steps in front
; of the player as soon as he stands in the Dawnstar Sanctuary or the Deep Sanctuary and she is not close.
Function DebriefTick()
    If GetStage() < 100 || bTableOpened
        bDebriefWatch = False
        Return
    EndIf
    Actor kPlayer = Game.GetPlayer()
    Cell kCell = kPlayer.GetParentCell()
    Cell kDawnstar = Game.GetFormFromFile(0x0193EE, "Skyrim.esm") as Cell
    Cell kDeep = Game.GetFormFromFile(0x001342, "NightsHarvest.esp") as Cell
    If !kCell || (kCell != kDawnstar && kCell != kDeep)
        Return
    EndIf
    Actor kVeyra = None
    If Core
        kVeyra = Core.GetVeyraActor()
    EndIf
    If !kVeyra || kVeyra.IsDead()
        Return
    EndIf
    If kVeyra.IsDisabled()
        kVeyra.Enable()
    EndIf
    If kVeyra.Is3DLoaded() && kPlayer.GetDistance(kVeyra) < 1500.0
        Return
    EndIf
    Float fAngle = kPlayer.GetAngleZ()
    kVeyra.MoveTo(kPlayer, 350.0 * Math.Sin(fAngle), 350.0 * Math.Cos(fAngle), 0.0)
    kVeyra.SetDontMove(True) ; hold her until the debrief is over (she walked off to her own package before)
    kVeyra.EvaluatePackage()
    NHV_Util.Log(NHV_Cfg_Debug, "DebriefTick: Veyra steps in front of the player")
EndFunction

Function OpenMapTable()
    If bTableOpened
        Return
    EndIf
    bTableOpened = True
    ObjectReference kTable = Game.GetFormFromFile(0x005ECD, "NightsHarvest.esp") as ObjectReference ; NHV_Mk_MapTable_Veyra
    Actor kVeyra = None
    If Core
        kVeyra = Core.GetVeyraActor()
    EndIf
    If kVeyra && kTable && !kVeyra.IsDead() && !kVeyra.IsDisabled()
        kVeyra.SetDontMove(False) ; she was held for the debrief
        kVeyra.MoveTo(kTable)
        kVeyra.EvaluatePackage()
        NHV_Util.Log(NHV_Cfg_Debug, "OpenMapTable: Veyra waits at the map table")
    Else
        NHV_Util.Log(NHV_Cfg_Debug, "OpenMapTable: Veyra or the table marker is missing")
    EndIf
    bTableCursorPending = True
    RegisterForSingleUpdate(2.0)
    Debug.Notification("Veyra waits at the map table in the Ledger Room.")
EndFunction

; Fallback to the map table menu: "Windhelm" is the first pin (button 0 -> Q02), started exactly like the table does it.
Function StartQ02FromTable()
    NHV_MapTableScript kTable = Game.GetFormFromFile(0x005ECC, "NightsHarvest.esp") as NHV_MapTableScript ; NHV_Ref_MapTable
    If kTable
        kTable.Choose(2)
    Else
        NHV_Util.Log(NHV_Cfg_Debug, "StartQ02FromTable: the map table script is not reachable")
    EndIf
EndFunction

Function EnableMarker(Int aiWhich)
    ObjectReference kMarker = None
    If aiWhich == 1
        kMarker = FarmMapMarker
    ElseIf aiWhich == 2
        kMarker = WatchpostMapMarker
    ElseIf aiWhich == 3
        kMarker = CampMapMarker
    EndIf
    If kMarker
        kMarker.Enable()
        NHV_Util.Log(NHV_Cfg_Debug, "Map marker " + aiWhich + " enabled")
    Else
        NHV_Util.Log(NHV_Cfg_Debug, "EnableMarker " + aiWhich + ": property not set in the CK")
    EndIf
EndFunction

; Stage 25: as soon as every soldier is dead the scout stops fighting and can be questioned.
Function BeginWatchpostWatch()
    If bWatchpostWatch
        Return
    EndIf
    bWatchpostWatch = True
    MakeScoutSafe()
    RegisterForSingleUpdate(3.0)
EndFunction

; The scout must survive the fight: he never takes part in it and cannot die (ingame test 01.10.2026: he fought the
; player and died, so nobody could be questioned). Essential persists on the base record, additive and idempotent.
Int Property FLOW_CURSOR_SCOUT = 28956 AutoReadOnly ; NHV_Q01V2_CursorScout (0x00711C): 49 = scout hub open

; The scout actor: the alias, or (alias still empty, e.g. the placed ref was not loaded when the quest started) the placed ref
; 0x0089F7 NHV_Ref_Q01_Scout, which then fills the alias. None only when the ref does not exist at all.
Actor Function GetScout()
    Actor kScout = None
    If ScoutAlias
        kScout = ScoutAlias.GetActorRef()
    EndIf
    If !kScout
        kScout = Game.GetFormFromFile(0x0089F7, "NightsHarvest.esp") as Actor
        If kScout && ScoutAlias
            ScoutAlias.ForceRefTo(kScout)
            NHV_Util.Log(NHV_Cfg_Debug, "GetScout: the scout alias was empty, filled from the placed ref")
        EndIf
    EndIf
    Return kScout
EndFunction

; Stage 25: the scout hub needs the scout cursor on 49..51 (49 is set at the end of the boot-print talk); repair a stale value.
Function EnsureScoutCursor()
    If GetStage() != 25
        Return
    EndIf
    Int iCur = NHV_Util.FlowGet(FLOW_CURSOR_SCOUT)
    If iCur < 49 || iCur > 51
        NHV_Util.FlowSet(FLOW_CURSOR_SCOUT, 49)
        NHV_Util.Log(NHV_Cfg_Debug, "EnsureScoutCursor: scout cursor was " + iCur + ", reset to 49")
    EndIf
EndFunction

Function MakeScoutSafe()
    Actor kScout = GetScout()
    If kScout
        kScout.GetActorBase().SetEssential(True)
        kScout.SetGhost(False) ; a ghost cannot be addressed (see Lucien): clear it in saves that got it from the previous build
        kScout.SetActorValue("Aggression", 0.0)
    Else
        NHV_Util.Log(NHV_Cfg_Debug, "MakeScoutSafe: the scout alias is not filled")
    EndIf
EndFunction

Bool bWatchpostAggro = False

; Soldiers and scout turn on the player when he comes close (no faction needed in the CK).
Function WatchpostAggro(Actor akPlayer)
    bWatchpostAggro = True
    Int i = 0
    While SoldierRefs && i < SoldierRefs.Length
        Actor kSoldier = SoldierRefs[i] as Actor
        If kSoldier && !kSoldier.IsDead()
            kSoldier.StartCombat(akPlayer)
        EndIf
        i += 1
    EndWhile
    MakeScoutSafe() ; the scout stays out of the fight
    NHV_Util.Log(NHV_Cfg_Debug, "Watchpost: the garrison attacks")
EndFunction

Function WatchpostCheck()
    Bool bAllDead = True
    Int iValid = 0
    Int j = 0
    While SoldierRefs && j < SoldierRefs.Length
        If SoldierRefs[j]
            iValid += 1
        EndIf
        j += 1
    EndWhile
    If iValid == 0
        ; the CK properties are not filled yet: do not soft-lock the quest, let the scout answer at once
        NHV_Util.Log(NHV_Cfg_Debug, "WatchpostCheck: SoldierRefs empty (CK property not set), the scout yields now")
        bWatchpostWatch = False
        ScoutYields()
        Return
    EndIf
    If !bWatchpostAggro && SoldierRefs && SoldierRefs.Length > 0 && SoldierRefs[0]
        Actor kPlayer = Game.GetPlayer()
        If kPlayer.GetParentCell() == SoldierRefs[0].GetParentCell() && kPlayer.GetDistance(SoldierRefs[0]) < 1500.0
            WatchpostAggro(kPlayer)
        EndIf
    EndIf
    Int i = 0
    While SoldierRefs && i < SoldierRefs.Length
        Actor kSoldier = SoldierRefs[i] as Actor
        If kSoldier && !kSoldier.IsDead()
            bAllDead = False
        EndIf
        i += 1
    EndWhile
    If bAllDead
        bWatchpostWatch = False
        ScoutYields()
    Else
        RegisterForSingleUpdate(3.0)
    EndIf
EndFunction

Function ScoutYields()
    Actor kScout = GetScout()
    If kScout && !kScout.IsDead()
        kScout.StopCombat()
        kScout.StopCombatAlarm()
        kScout.SetGhost(False)
        kScout.SetActorValue("Aggression", 0.0)
        kScout.RestoreActorValue("Health", 1000.0) ; get him out of bleedout quickly so he can be addressed
        kScout.EvaluatePackage()
        EnsureScoutCursor()
    Else
        ; no scout to question (dead or never filled): do not soft-lock, skip his conversation and send the player to the camp
        NHV_Util.Log(NHV_Cfg_Debug, "ScoutYields: the scout is missing or dead, skipping to the camp")
        EnableMarker(3)
        If GetStage() < 30
            SetStage(30)
        EndIf
        Return
    EndIf
    ; (the old scoutYield flag is not used any more: the scout talk is a hub that is always available at stage 25)
    NHV_Util.Log(NHV_Cfg_Debug, "Watchpost cleared, the scout can be questioned")
EndFunction

Function QuintusToInn()
    MakeQuintusMortal()
    SetQuintusAtFarm(False)
    MoveQuintus(QuintusInnSpot, "inn")
EndFunction

Function QuintusToFarm()
    SetQuintusAtFarm(True) ; before the move: also valid when Quintus is not available (Hrefna still waits on the farm)
    MoveQuintus(QuintusFarmSpot, "farm")
EndFunction

; Global 0xAD20 (NHV_Q01_QuintusAtFarm, 1 = Quintus waits on the farm) is the condition of NHV_Pkg_Q01_QuintusFarmHold and
; NHV_Pkg_Q01_HrefnaFarmWaitDay/Night. Looked up by FormID (no CK property needed). Reset to 0 whenever the quest is before stage 45.
Function SetQuintusAtFarm(Bool abAtFarm)
    GlobalVariable kAtFarm = Game.GetFormFromFile(0x00AD20, "NightsHarvest.esp") as GlobalVariable
    If !kAtFarm
        NHV_Util.Log(NHV_Cfg_Debug, "SetQuintusAtFarm: global NHV_Q01_QuintusAtFarm (0xAD20) missing, Quintus and Hrefna farm packages keep the old state")
        Return
    EndIf
    Int iNew = 0
    If abAtFarm
        iNew = 1
    EndIf
    If kAtFarm.GetValueInt() != iNew
        kAtFarm.SetValueInt(iNew)
        NHV_Util.Log(NHV_Cfg_Debug, "SetQuintusAtFarm: " + iNew)
    EndIf
EndFunction

Function MoveQuintus(ObjectReference akSpot, String asWhere)
    Actor kQuintus = None
    If QuintusAlias
        kQuintus = QuintusAlias.GetActorRef()
    EndIf
    If !kQuintus || kQuintus.IsDead()
        Return
    EndIf
    If akSpot
        If kQuintus.IsDisabled()
            kQuintus.Enable()
        EndIf
        kQuintus.MoveTo(akSpot)
        kQuintus.EvaluatePackage()
        NHV_Util.Log(NHV_Cfg_Debug, "Quintus moved to the " + asWhere)
    Else
        NHV_Util.Log(NHV_Cfg_Debug, "MoveQuintus: spot for the " + asWhere + " not set in the CK")
    EndIf
EndFunction

; Branch "Hrefna kills": the death is handled by OnQuintusKilled(), which moves the story to the papers.
Function HrefnaKillsQuintus()
    Actor kHrefna = None
    Actor kQuintus = None
    If HrefnaAlias
        kHrefna = HrefnaAlias.GetActorRef()
    EndIf
    If QuintusAlias
        kQuintus = QuintusAlias.GetActorRef()
    EndIf
    If !kHrefna || !kQuintus || kHrefna.IsDead() || kQuintus.IsDead()
        NHV_Util.Log(NHV_Cfg_Debug, "HrefnaKillsQuintus: Hrefna or Quintus not available")
        Return
    EndIf
    MakeQuintusMortal()
    bHrefnaAttacked = True
    bHrefnaFought = True
    kHrefna.GetActorBase().SetProtected(True)
    HrefnaAssassinatesQuintus(kHrefna, kQuintus)
EndFunction

; Branch "Hrefna surrenders": both leave for the farm, the papers conversation follows there.
Function CaptureOutcome()
    Actor kHrefna = None
    If HrefnaAlias
        kHrefna = HrefnaAlias.GetActorRef()
    EndIf
    If kHrefna && HrefnaFarmSpot
        kHrefna.MoveTo(HrefnaFarmSpot)
        kHrefna.EvaluatePackage()
    Else
        NHV_Util.Log(NHV_Cfg_Debug, "CaptureOutcome: Hrefna or the farm spot is missing")
    EndIf
    QuintusToFarm()
    If kHrefna
        kHrefna.EvaluatePackage() ; the farm wait package of Hrefna depends on the global QuintusToFarm() just set
    EndIf
    If NHV_Flag_HrefnaUnproven
        NHV_Flag_HrefnaUnproven.SetValueInt(1)
    EndIf
    StockQuintusBody() ; the papers conversation needs the dispatch even though Quintus lives
    AdvanceToPapers()
EndFunction

; Branch "the Listener kills": Quintus turns on the player at the farm.
Function QuintusHostile()
    Actor kQuintus = None
    If QuintusAlias
        kQuintus = QuintusAlias.GetActorRef()
    EndIf
    If kQuintus && !kQuintus.IsDead()
        MakeQuintusMortal()
        kQuintus.StartCombat(Game.GetPlayer())
    EndIf
EndFunction

; Stage 60 and the papers conversation (Hrefna speaks first when the player talks to her).
Function AdvanceToPapers()
    If GetStage() < 60
        SetStage(60)
    EndIf
    NHV_Util.FlowSet(FLOW_CURSOR_MAIN, FLOW_ENTRY_PAPERS)
EndFunction

; ---------------------------------------------------------------------------
; Homecoming (V2): after "Recruit" Hrefna stands in the Kitchen; the first time the player comes near her there,
; Nazir and Hrefna meet him in scene NHV_Scn_Q01_04Home (0x7F01). Armed by NHV_CoreScript.OnEnterDeepSanctuary().
; ---------------------------------------------------------------------------
Bool bHomeScenePlayed = False
Bool bHomeWatch = False

Function ArmHomeWatch()
    If bHomeScenePlayed || bHomeWatch || GetStage() < 100 || !NHV_Status_Hrefna
        Return
    EndIf
    If NHV_Status_Hrefna.GetValueInt() != STATUS_RECRUITED
        Return
    EndIf
    bHomeWatch = True
    RegisterForSingleUpdate(3.0)
EndFunction

Function HomeWatchCheck()
    Actor kPlayer = Game.GetPlayer()
    Actor kHrefna = None
    If HrefnaFamilySlotAlias
        kHrefna = HrefnaFamilySlotAlias.GetActorRef()
    EndIf
    If bHomeScenePlayed || !KitchenMarker || !kPlayer || !kHrefna || kHrefna.IsDead()
        bHomeWatch = False
        Return
    EndIf
    If kPlayer.GetParentCell() != KitchenMarker.GetParentCell()
        bHomeWatch = False ; the player left the Deep Sanctuary: the next entry arms the watch again
        Return
    EndIf
    Scene kScene = Game.GetFormFromFile(0x007F01, "NightsHarvest.esp") as Scene
    If kScene && !kScene.IsPlaying() && !kPlayer.IsInCombat() && kPlayer.GetDistance(KitchenMarker) <= 600.0 && kHrefna.Is3DLoaded()
        bHomeScenePlayed = True
        bHomeWatch = False
        kScene.Start()
        NHV_Util.Log(NHV_Cfg_Debug, "Q01 homecoming scene started")
    Else
        RegisterForSingleUpdate(3.0) ; not there yet, busy, or in combat: try again
    EndIf
EndFunction

; Called from the Stage 60 fragment when the player searches Quintus' belongings.
Function GiveOculatusFragment()
    GiveFragmentIfMissing(None, OculatusFragment1)
EndFunction

; ---------------------------------------------------------------------------
; Stage 70: Judgement
; ---------------------------------------------------------------------------
; All three functions guard on GetStage() == 70 so a doubled dialogue callback (e.g. the topic
; fires twice from a fast double-click) can never run the outcome twice.

Function JudgeRecruit()
    If GetStage() != 70
        Return
    EndIf
    If !HrefnaAlias
        NHV_Util.Log(NHV_Cfg_Debug, "JudgeRecruit: HrefnaAlias property not set in the CK")
        Return
    EndIf
    Actor kHrefna = HrefnaAlias.GetActorRef()
    Actor kPlayer = Game.GetPlayer()
    If BogwifesKnife && kPlayer
        kPlayer.AddItem(BogwifesKnife, 1, True)
    EndIf
    ; Stage 100 FIRST: NHV_Pkg_Hrefna_CampWait (Q01 stage < 100) must be invalid before she is moved and
    ; re-evaluated, otherwise she walks straight back to her camp (ingame test 29.09.2026).
    SetStage(100)
    CompleteRecruitment(kHrefna, NHV_Status_Hrefna, HrefnaFamilySlotAlias, HrefnaAlias, KitchenMarker)
    bRecruitHomeChecked = True ; she was placed correctly just now
EndFunction

Function JudgeRelease()
    If GetStage() != 70
        Return
    EndIf
    If NHV_Status_Hrefna
        NHV_Status_Hrefna.SetValueInt(STATUS_RELEASED)
    EndIf
    fLetterDueGameTime = Utility.GetCurrentGameTime() + 7.0 ; 7 in-game days, concept section 7
    RegisterForSingleUpdateGameTime(168.0)
    SetStage(100)
EndFunction

Function JudgeSilence()
    If GetStage() != 70
        Return
    EndIf
    ; Set STATUS_KILLED immediately: the Brotherhood's judgement is final the moment it is spoken,
    ; regardless of whether the ensuing fight actually finishes her off in this session (she could
    ; flee, or the player could stop chasing). This guarantees the Global never sits at
    ; STATUS_UNKNOWN forever. RecruitDied() (triggered by her eventual OnDeath, whenever that
    ; happens) still fires the NHV_RecruitDied ModEvent - only the redundant SetValueInt is skipped
    ; there since the status already reads STATUS_KILLED.
    If NHV_Status_Hrefna
        NHV_Status_Hrefna.SetValueInt(STATUS_KILLED)
    EndIf
    If !HrefnaAlias
        NHV_Util.Log(NHV_Cfg_Debug, "JudgeSilence: HrefnaAlias property not set in the CK")
    Else
        Actor kHrefna = HrefnaAlias.GetActorRef()
        If kHrefna && !kHrefna.IsDead()
            ; NHV_Hrefna is Essential in the ESP (feedback 03.10.2026): the judgement "Silence" is the one intended death,
            ; so she becomes mortal right here, just before the fight (concept: "bei Freilassung oder ihrem Tod")
            kHrefna.GetActorBase().SetEssential(False)
            kHrefna.GetActorBase().SetProtected(False)
            kHrefna.StartCombat(Game.GetPlayer())
        EndIf
    EndIf
    SetStage(100)
EndFunction

; ---------------------------------------------------------------------------
; Release letter (game-time timer, fully independent of the OnUpdate cutscene watchdog above)
; ---------------------------------------------------------------------------
; CK NOTE (team lead, 28.09.2026): Stage 100 SHOULD be flagged "Complete Quest" - that only marks the
; quest completed in the journal, it keeps running and still receives OnUpdateGameTime/OnPlayerLoadGame.
; What must NOT happen before the release letter is delivered is Stop() / "Shut Down Quest": a stopped
; Q01 could never deliver the letter or reconcile the timer on load.
; Leave Stage 100 as the quest's final-but-not-completed stage instead (a common, intentional
; Bethesda pattern for exactly this reason); the Journal/Debrief plays identically either way. See
; docs/ck/M1.6-Q01-CK-Anleitung.md and docs/plan/Q01-The-Unanswered-Sacrament.md section 8b.

; Defense in depth for OnContractLoadGame() below and for the timer surviving an unexpected engine
; hiccup: always re-derives the wait from the stored absolute due time rather than trusting that a
; previously registered RegisterForSingleUpdateGameTime call is still pending.
Event OnUpdateGameTime()
    If fLetterDueGameTime <= 0.0
        Return ; stray callback, nothing pending
    EndIf
    Float fRemainingDays = fLetterDueGameTime - Utility.GetCurrentGameTime()
    If fRemainingDays <= 0.0
        fLetterDueGameTime = 0.0
        DeliverReleaseLetter()
    Else
        ; re-arm for exactly what is left; covers a load that jumped the clock forward or back
        RegisterForSingleUpdateGameTime(fRemainingDays * 24.0)
    EndIf
EndEvent

Function DeliverReleaseLetter()
    Actor kPlayer = Game.GetPlayer()
    If kPlayer && HrefnaReleaseLetter
        kPlayer.AddItem(HrefnaReleaseLetter, 1, True)
        NHV_Util.Log(NHV_Cfg_Debug, "DeliverReleaseLetter: letter delivered")
    EndIf
EndFunction

; Overrides NHV_ContractBaseScript.OnContractLoadGame(), called from
; NHV_ContractPlayerAliasScript.OnPlayerLoadGame(). Re-arms the release-letter timer on load: if
; fLetterDueGameTime is still pending but for any reason (engine hiccup, a future edit that stops
; the quest too early) no OnUpdateGameTime callback is currently scheduled, this makes sure one gets
; scheduled again instead of the letter silently never arriving. Safe to call even when a callback IS
; still pending - RegisterForSingleUpdateGameTime just replaces it with the same due time.
Function OnContractLoadGame()
    If GetStage() < 45
        SetQuintusAtFarm(False) ; quest (re)started before the Quintus decision: nobody waits on the farm
    EndIf
    If GetStage() != 50 || (VeyraTrialScene && !VeyraTrialScene.IsPlaying())
        ReleaseVeyraFromTrial() ; a hold from an interrupted trial must not outlive the trial scene
    EndIf
    If GetStage() >= 50
        MakeQuintusMortal() ; saves that reached stage 50 before this fix (ingame test 29.09.2026)
    EndIf
    If GetStage() >= 60 && GetStage() < 100
        StockQuintusBody() ; saves where Quintus died before his body carried the papers
    EndIf
    If GetStage() >= 60
        RestoreHrefnaAfterFight() ; no-op unless a fight state was left behind
    ElseIf GetStage() == 50
        Actor kQuintusDead = None
        If QuintusAlias
            kQuintusDead = QuintusAlias.GetActorRef()
        EndIf
        If kQuintusDead && kQuintusDead.IsDead()
            OnQuintusKilled(None) ; he died while the OnDeath event was missed (load, odd death): move on
        ElseIf bHrefnaWillKill && !bHrefnaAttacked
            RegisterForSingleUpdate(2.0) ; resume the kill watch after loading
        ElseIf bHrefnaAttacked && bHrefnaFought && kQuintusDead && kQuintusDead.Is3DLoaded() && HrefnaAlias
            ; save made mid-fight by a build before the assassination (30.09.2026): end that duel now
            Actor kHrefnaLoaded = HrefnaAlias.GetActorRef()
            If kHrefnaLoaded && !kHrefnaLoaded.IsDead()
                HrefnaAssassinatesQuintus(kHrefnaLoaded, kQuintusDead)
            EndIf
        EndIf
    EndIf
    If GetStage() >= 30
        bVeyraJoined = True ; saves past the farm: she is already part of the party
    EndIf
    If GetStage() >= 100 && !bTableOpened
        BeginDebriefWatch()
    EndIf
    If GetStage() >= 20 && GetStage() < 70
        BeginVeyraWatch() ; the watch is also needed in saves that reached stage 20 without the marker handover
    EndIf
    If GetStage() < 10
        bReedFightStarted = False ; quest (re)set: the reedbed starts from scratch
        bReedbedLootReleased = False
        bReedbedWatch = False
        bReedFightPending = False
        bDeathWatch = False
        bHakanDeathHandled = False
        bHrefnaDeathHandled = False
    Else
        BeginReedbedWatch() ; no-op once the sack is free (loot released or stage 20+)
        ArmDeathWatch()
    EndIf
    ReturnRecruitHome()
    bHomeWatch = False ; a load drops the timer: arm the homecoming watch again if it is due
    ArmHomeWatch()
    If GetStage() == 30 && !bCampAmbushDone
        bCampWatchStarted = False
        BeginCampWatch() ; the camp poll does not survive a load either
    EndIf
    If GetStage() == 25
        MakeScoutSafe() ; also clears a leftover ghost flag in saves
        EnsureScoutCursor()
    EndIf
    If bWatchpostWatch && GetStage() == 25
        RegisterForSingleUpdate(3.0)
    EndIf
    RearmWatches()
    If fLetterDueGameTime <= 0.0
        Return ; nothing pending
    EndIf
    Float fRemainingDays = fLetterDueGameTime - Utility.GetCurrentGameTime()
    If fRemainingDays <= 0.0
        fLetterDueGameTime = 0.0
        DeliverReleaseLetter()
    Else
        RegisterForSingleUpdateGameTime(fRemainingDays * 24.0)
    EndIf
EndFunction

; NHV_Quintus is Essential in the ESP so he cannot die before the trial. From stage 50 on he must be killable
; (by Hrefna or the player); ActorBase.SetEssential persists in the save. Idempotent.
Function MakeQuintusMortal()
    If !QuintusAlias
        Return
    EndIf
    Actor kQuintus = QuintusAlias.GetActorRef()
    If !kQuintus
        NHV_Util.Log(NHV_Cfg_Debug, "MakeQuintusMortal: QuintusAlias empty")
        Return
    EndIf
    ActorBase kBase = kQuintus.GetActorBase()
    If kBase.IsEssential()
        kBase.SetEssential(False)
        NHV_Util.Log(NHV_Cfg_Debug, "Quintus is no longer essential")
    EndIf
EndFunction

; Quintus' papers (field note + Oculatus fragment 1) on his body, so stage 60 "search his belongings" has
; something to find. Idempotent: only adds what the body and the player do not have yet.
Bool bBodyStocked = False
Bool bRecruitReturned = False       ; legacy one-shot (first repair, 29.09.2026), kept for saves
Bool bRecruitHomeChecked = False    ; second repair: she left again although the first check ran (CampWait still valid)

Function StockQuintusBody()
    If bBodyStocked || !QuintusAlias
        Return
    EndIf
    Actor kQuintus = QuintusAlias.GetActorRef()
    If !kQuintus
        Return
    EndIf
    Actor kPlayer = Game.GetPlayer()
    If QuintusFieldNote && kQuintus.GetItemCount(QuintusFieldNote) == 0 && kPlayer.GetItemCount(QuintusFieldNote) == 0
        kQuintus.AddItem(QuintusFieldNote, 1, True)
    EndIf
    If OculatusFragment1 && kQuintus.GetItemCount(OculatusFragment1) == 0 && kPlayer.GetItemCount(OculatusFragment1) == 0
        kQuintus.AddItem(OculatusFragment1, 1, True)
    EndIf
    bBodyStocked = True ; once: items the player drops or sells later are not restocked
EndFunction

; A recruited Hrefna walked back to her camp (CampWait had no stage condition before 29.09.2026): put her home.
Function ReturnRecruitHome()
    If bRecruitHomeChecked || GetStage() < 100 || !HrefnaFamilySlotAlias || !KitchenMarker || !NHV_Status_Hrefna
        Return
    EndIf
    If NHV_Status_Hrefna.GetValueInt() != STATUS_RECRUITED
        Return
    EndIf
    Actor kHrefna = HrefnaFamilySlotAlias.GetActorRef()
    If kHrefna && !kHrefna.IsDead() && kHrefna.GetParentCell() != KitchenMarker.GetParentCell()
        kHrefna.MoveTo(KitchenMarker)
        NHV_Util.Log(NHV_Cfg_Debug, "Hrefna returned to the Kitchen")
    EndIf
    If kHrefna && !kHrefna.IsDead()
        kHrefna.EvaluatePackage() ; also drops CampWait (stage 100 is done) for a save where she never left
    EndIf
    bRecruitHomeChecked = True ; one-time repair only; later family logic owns her position
EndFunction
