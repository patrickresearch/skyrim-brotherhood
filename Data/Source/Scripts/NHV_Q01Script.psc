    If HrefnaAlias
        kHrefna = HrefnaAlias.GetActorRef()
    EndIf
    If !kHrefna
        kHrefna = Game.GetFormFromFile(0x004981, "NightsHarvest.esp") as Actor ; NHV_HrefnaRef
    EndIf
