        kHakan = HakanAlias.GetActorRef()
    EndIf
    If !kHakan
        kHakan = Game.GetFormFromFile(0x0048A6, "NightsHarvest.esp") as Actor ; NHV_HakanRef
    EndIf
    Return kHakan
EndFunction

Actor Function GetHrefna()
