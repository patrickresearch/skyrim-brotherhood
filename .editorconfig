root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Papyrus-Quellen: CRLF, 4 Leerzeichen wie in den Vorlagen (.claude/skills/papyrus-script/templates.md)
[Data/**/*.psc]
end_of_line = crlf
indent_style = space
indent_size = 4

# MCM-Übersetzung: UTF-16 LE mit BOM, CRLF
[Data/Interface/Translations/*.txt]
charset = utf-16le
end_of_line = crlf
